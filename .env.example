# =====================================================================
# BIBLIOVOLTA · Variabili d'ambiente
# Copia questo file in .env.local (sviluppo) e inserisci i valori reali.
# In produzione le stesse variabili vanno impostate su Vercel.
# NON committare mai .env.local: è già escluso da .gitignore.
# =====================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) oppure, sui progetti meno recenti, la "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" / service role: SOLO server. Mai con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (invio email, Fase 6)
RESEND_API_KEY=
# Mittente su un dominio verificato in Resend
EMAIL_FROM="BIBLIOVOLTA <bibliovolta@liceovoltacomo.edu.it>"

# Indirizzo pubblico del sito (in sviluppo http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anteprima delle schermate con dati dimostrativi (/anteprima).
# Sempre attiva in sviluppo; in produzione solo se impostata a true.
ENABLE_UI_PREVIEW=false

# Password iniziale degli account docente (solo server e script).
# Al primo accesso ogni docente deve sostituirla con una personale.
TEACHER_INITIAL_PASSWORD=

# Segreto per /api/cron/notifications (almeno 16 caratteri casuali).
# Lo stesso valore va usato nella pianificazione di Supabase Cron (README).
CRON_SECRET=
